pipeline{
   agent any

   stages{
      stage('Checkout'){
          steps{
              git 'https://github.com/aslin-123/DevopsPractical.git'
          }

      }
      stage('Publish'){
            steps{
                publishHTML([
                   allowmissing:true,
                   alwaysLinktoLastBuild:false,
                   KeepAll:false,
                   reportDir:'.',
                   reportFiles:'Index.html',
                   reportName:'MY HTML PAGE'
                ])
            }
      }
   }

}
